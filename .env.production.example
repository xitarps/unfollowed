# Production environment values. Copy to .env.production (gitignored).

RAILS_ENV=production
# Paste the value from config/master.key. Do not invent this.
RAILS_MASTER_KEY=
RAILS_LOG_LEVEL=info
TZ=America/Fortaleza

# The Compose redis service has no password, so this URL must not include one.
REDIS_URL=redis://redis:6379/0
SIDEKIQ_CONCURRENCY=5
SIDEKIQ_WEB_USERNAME=admin
SIDEKIQ_WEB_PASSWORD=change-me
