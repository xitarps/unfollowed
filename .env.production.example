# Production environment values. Copy to .env.production (gitignored).

RAILS_ENV=production
# Paste the value from config/master.key. Do not invent this.
RAILS_MASTER_KEY=
RAILS_LOG_LEVEL=info
FORCE_SSL=true
TZ=America/Fortaleza

# The Compose redis service has no password, so this URL must not include one.
REDIS_URL=redis://redis:6379/0
SIDEKIQ_CONCURRENCY=5
SIDEKIQ_WEB_USERNAME=admin
SIDEKIQ_WEB_PASSWORD=change-me

# PostgreSQL (Rails app + Keycloak share this server)
DB_USERNAME=unfollowed
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_NAME=unfollowed_production
KEYCLOAK_DB_NAME=keycloak

# Domains (Caddy issues Let's Encrypt certificates; DNS A records for
# APP_DOMAIN, www.APP_DOMAIN and KEYCLOAK_DOMAIN must point to this server).
APP_DOMAIN=unfollowed.com.br
KEYCLOAK_DOMAIN=auth.unfollowed.com.br
ACME_EMAIL=xitarps@gmail.com

# Keycloak runs behind Caddy: TLS terminates at the proxy.
KEYCLOAK_COMMAND=start
KEYCLOAK_EXTRA_ARGS=
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_HOST_PORT=8080
KC_HOSTNAME=https://auth.unfollowed.com.br
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HEALTH_ENABLED=true
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
KC_DB=postgres
KC_DB_URL_HOST=db
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=unfollowed
KC_DB_PASSWORD=change-me
