<%= turbo_frame_tag "unfollowers-list", src: unfollowers_path(page: params[:page]), loading: :lazy,
      data: { turbo_action: "advance" } do %>
  <div class="page-header">
    <h1><%= t("unfollowers.title") %></h1>
  </div>
  <div class="glass-list" role="status" aria-label="<%= t("unfollowers.loading") %>">
    <% 6.times do %>
      <div class="glass-row">
        <span class="skeleton skeleton-avatar"></span>
        <span class="skeleton skeleton-text"></span>
        <span class="skeleton skeleton-btn"></span>
      </div>
    <% end %>
  </div>
<% end %>
