<%= turbo_frame_tag "unfollowers-list", data: { turbo_action: "advance" } do %>
<% if @error %>
  <p class="flash alert"><%= @error %></p>
<% end %>
<div class="page-header">
  <h1>People you follow who don't follow you back</h1>
  <% if @users.total_count.positive? %>
    <%= button_to "Unfollow all (#{@users.total_count})", unfollow_all_unfollowers_path, method: :post,
          data: { turbo_confirm: "Unfollow all #{@users.total_count} accounts that don't follow you back?" },
          form: { class: "inline-form", data: { turbo_frame: "_top" } }, class: "btn-ruby" %>
  <% end %>
</div>

<% if @users.empty? %>
  <p class="lead">Everyone you follow follows you back.</p>
<% else %>
  <div class="glass-list" role="list">
    <% @users.each do |user| %>
      <div class="glass-row" role="listitem">
        <img src="<%= user[:avatar_url] %>" width="48" height="48" alt="<%= user[:login] %>">
        <%= link_to user[:login], "https://github.com/#{user[:login]}", target: "_blank", rel: "noopener", class: "glass-row-name" %>
        <%= button_to "Unfollow", unfollow_unfollower_path(user[:login], page: params[:page]), method: :post,
              data: { turbo_confirm: "Unfollow #{user[:login]}?" }, form: { data: { turbo_frame: "_top" } },
              class: "btn-ruby small" %>
      </div>
    <% end %>
  </div>

  <%= paginate @users %>
<% end %>
<% end %>
