<%# Fixed palette of warm ruby tones; each light cycles through them with its own speed and offset. %>
<% palette = %w[#ff2a1f #cc342d #ff6a1a #ffb347 #9b111e] %>
<div class="ruby-lights" aria-hidden="true">
  <% 18.times do |i| %>
    <% colors = palette.rotate(i * 2).first(3) %>
    <span class="light" style="--duration: <%= (44.1 - i * 0.9).round(1) %>s; --delay: -<%= (1.8 * (i + 1)).round(1) %>s; --c1: <%= colors[0] %>; --c2: <%= colors[1] %>; --c3: <%= colors[2] %>"></span>
  <% end %>
  <span class="mask-h"></span>
  <span class="mask-v"></span>
</div>
