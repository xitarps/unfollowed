<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Unfollowed" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Unfollowed">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/logo.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.svg">
    <meta name="theme-color" content="#cc342d">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/ruby_lights" %>
    <header class="site-header">
      <div class="site-brand">
        <%= image_tag "/logo.png", class: "logo-xl", alt: "Unfollowed" %>
        <span class="site-title">Unfollowed</span>
      </div>

      <nav class="site-nav">
        <%= render "shared/locale_toggle" %>
        <% if current_user %>
          <span class="signed-in"><%= t("layout.signed_in_as") %> <strong><%= current_user["name"] %></strong></span>
          <%= button_to sign_out_path, method: :delete, class: "btn-ruby small",
                form: { class: "inline-form", data: { turbo: false, controller: "loading-button", loading_button_text_value: t("layout.signing_out"), action: "submit->loading-button#start" } },
                data: { loading_button_target: "button" } do %>
            <span class="spinner" aria-hidden="true"></span>
            <span data-loading-button-target="label"><%= t("layout.sign_out") %></span>
          <% end %>
        <% else %>
          <%= render "shared/sign_in_button" %>
        <% end %>
      </nav>
    </header>

    <div class="flash-wrapper">
      <% flash.each do |k, v| %>
        <div class="flash <%= k %>"><%= v %></div>
      <% end %>
    </div>

    <main class="site-main">
      <%= yield %>
    </main>

    <% cache static_cache_key([ "footer", Time.current.year ]) do %>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <%= image_tag "/logo.png", class: "logo-small", alt: "Unfollowed" %>
          <strong>Unfollowed</strong>
        </div>
        <div class="footer-links">
          <%= link_to t("layout.footer.home"), root_path %>
          <%= link_to t("layout.footer.terms"), terms_path %>
          <%= link_to t("layout.footer.privacy"), privacy_path %>
          <%= link_to t("layout.footer.contact"), contact_path %>
        </div>
        <div class="footer-copy"><%= t("layout.footer.copyright", year: Time.current.year) %></div>
      </div>
    </footer>
    <% end %>
  </body>
</html>
