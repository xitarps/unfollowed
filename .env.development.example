# Development values. Copy to .env.

REDIS_URL=redis://redis:6379/0
RAILS_ENV=development
TZ=America/Fortaleza
TERM=xterm-256color
SIDEKIQ_CONCURRENCY=3
SIDEKIQ_WEB_USERNAME=admin
SIDEKIQ_WEB_PASSWORD=change-me

# Keycloak (dev mode, data stored in PostgreSQL)
KC_DB=postgres
KC_DB_URL_HOST=db
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=postgres
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
KC_HTTP_PORT=8080
KC_HOSTNAME_STRICT=false
KEYCLOAK_COMMAND=start-dev
KEYCLOAK_EXTRA_ARGS=
KEYCLOAK_BIND_ADDRESS=0.0.0.0
KEYCLOAK_HOST_PORT=8080

# PostgreSQL (Rails app + Keycloak share this server)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=unfollowed_development
DB_HOST_PORT=5432
KEYCLOAK_DB_NAME=keycloak
