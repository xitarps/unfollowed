# Development values. Copy to .env.

REDIS_URL=redis://redis:6379/0
RAILS_ENV=development
TZ=America/Fortaleza
TERM=xterm-256color
SIDEKIQ_CONCURRENCY=3
SIDEKIQ_WEB_USERNAME=admin
SIDEKIQ_WEB_PASSWORD=change-me

# Keycloak (dev mode, data stored in PostgreSQL)
KC_DB=postgres
KC_DB_URL_HOST=db
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=postgres
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
KC_HTTP_PORT=8080
KC_HOSTNAME=http://localhost:8080
KC_HOSTNAME_STRICT=false
KEYCLOAK_COMMAND=start-dev
KEYCLOAK_EXTRA_ARGS=--import-realm
KEYCLOAK_BIND_ADDRESS=0.0.0.0
KEYCLOAK_HOST_PORT=8080

# PostgreSQL (Rails app + Keycloak share this server)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=unfollowed_development
DB_HOST_PORT=5432
KEYCLOAK_DB_NAME=keycloak

# Authentication: Rails -> Keycloak (OIDC) -> GitHub
APP_URL=http://localhost:3000
OIDC_ISSUER=http://localhost:8080/realms/unfollowed
OIDC_INTERNAL_URL=http://keycloak:8080/realms/unfollowed
OIDC_CLIENT_ID=unfollowed
OIDC_CLIENT_SECRET=change-me
# Empty shows the Keycloak login page; "github" sends users straight to GitHub.
OIDC_IDP_HINT=github
# GitHub OAuth App (callback: <KC_HOSTNAME>/realms/unfollowed/broker/github/endpoint)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
